{
  "entities": {
    "UserProfile": {
      "title": "User Profile",
      "description": "User profile information stored upon authentication",
      "type": "object",
      "properties": {
        "uid": {
          "type": "string",
          "description": "Unique identifier of the user"
        },
        "email": {
          "type": "string",
          "description": "User email address"
        },
        "displayName": {
          "type": "string",
          "description": "Full name or display name of the user"
        },
        "photoURL": {
          "type": "string",
          "description": "Avatar image URL"
        },
        "createdAt": {
          "type": "string",
          "format": "date-time",
          "description": "Account creation timestamp"
        }
      },
      "required": ["uid", "email", "createdAt"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": {
        "$ref": "#/entities/UserProfile"
      },
      "description": "User profile document accessible by the user themselves"
    }
  }
}
